# =============================================================================
# .dockerignore — keep the build context small and exclude secrets
# =============================================================================
# Version:    2.0
# Updated:    2024-01-01
# Companion:  Dockerfile (multi-stage, non-root, tini)
#
# SYNTAX RULES
# ------------
#   1. Comments must be on their OWN line. Docker's .dockerignore does NOT
#      support inline comments. A line like:
#          config/file.yaml   # note
#      becomes a pattern that matches the literal string
#          config/file.yaml   # note
#      and excludes NOTHING.
#   2. `!pattern` re-includes a file previously excluded. The `!` rule must
#      come AFTER the pattern it negates.
#   3. Patterns are matched against the build-context root. `*.md` matches
#      `README.md` at root but NOT `src/README.md`. Use `**/*.md` for any
#      depth.
#   4. Trailing `/` on directory patterns is optional but conventional.
#
# DO NOT EXCLUDE (Dockerfile depends on these)
# --------------------------------------------
#   requirements.txt       ← COPY'd by Dockerfile
#   requirements.lock.txt  ← COPY'd when present (--require-hashes)
#   pyproject.toml         ← `pip install -e .` reads it
#   setup.py / setup.cfg   ← `pip install -e .` fallback
#   runtime/run_agent.py   ← entrypoint
#   src/                   ← application code
#   core/                  ← application code
# =============================================================================


# -----------------------------------------------------------------------------
# Version control
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.gitmodules
.github/
.gitlab-ci.yml
.circleci/
.travis.yml
.buildkite/

# -----------------------------------------------------------------------------
# Secrets — never ship these in an image layer
# -----------------------------------------------------------------------------
.env
.env.*
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
run/secrets/

# If `.env.example` is needed for onboarding, uncomment:
# !.env.example

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.dist-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.cache/
venv/
.venv/
env/
ENV/

# -----------------------------------------------------------------------------
# Python test artifacts
# -----------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Node
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
.pnpm-store/

# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------
build/
dist/
*.whl
*.tar
*.tar.gz
*.tgz
*.zip

# -----------------------------------------------------------------------------
# Agent output — generated at runtime
# -----------------------------------------------------------------------------
results/
demo_output/
green_agent_data/
logs/
*.log

# -----------------------------------------------------------------------------
# Editor / patch artifacts
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*.rej
*.tmp
.helix/
.nvim/

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
Spotlight-V100/
.Trashes/

# -----------------------------------------------------------------------------
# Jupyter artifacts
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Documentation
# -----------------------------------------------------------------------------
# Excluded by default to keep the image small. Add `!README.md` AFTER this
# section if the image needs a root-level README.
docs/
*.md
!README.md

# -----------------------------------------------------------------------------
# Tests — excluded from the runtime image
# -----------------------------------------------------------------------------
tests/
test_*.py
*_test.py

# -----------------------------------------------------------------------------
# Deploy-time configuration — must not be baked into the image
# -----------------------------------------------------------------------------
# FIXED: the previous version had an inline comment on the second line:
#     config/base/green_agent_config.yaml   # deploy-time, not build-time
# Docker's .dockerignore does not support inline comments — the whole line
# became a literal pattern that matched nothing, so the file was NOT
# excluded. Fixed by moving the comment to its own line above the pattern.
config/base/green_agent_config.yaml
config/*.local.*
config/secrets.*
