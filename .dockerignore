# .dockerignore — keep the build context small and exclude secrets.
#
# WHAT CHANGED FROM NOTHING (v1.0 shipped without this file)
# ---------------------------------------------------------
# v1.0's `COPY . .` copied .git (hundreds of MB), .env (secrets!),
# __pycache__, venv, test artifacts, and the results directory. This file
# fixes that.

# VCS
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml

# Secrets — never copy these into an image layer
.env
.env.*
*.pem
*.key
*.crt
secrets/
run/secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# Node
node_modules/
npm-debug.log

# Build artifacts
build/
dist/
*.whl
*.egg

# Agent output — generated at runtime
results/
demo_output/
green_agent_data/
logs/
*.log
green_agent_moe.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docs — excluded to keep the image small
docs/
*.md
!README.md

# Tests — excluded from the runtime image
tests/
test_*.py
*_test.py

# Local config that should never leak
config/*.local.*
config/base/green_agent_config.yaml   # deploy-time, not build-time
