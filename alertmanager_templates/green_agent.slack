# monitoring/alertmanager/alertmanager_templates/green_agent.slack
#
# Green Agent v5.0.0 — Slack templates
# ====================================
#
# Companion: `alertmanager.yml` (v5.0.0). Do NOT inline these templates
# into the config file — Alertmanager loads them via `templates:`.
#
# Rendered with `.` = the Alertmanager Data struct, which carries:
#   .Status, .Alerts.Firing, .Alerts.Resolved,
#   .CommonLabels, .CommonAnnotations, .ExternalURL, .GroupLabels, .Receiver
#
# ── Whitespace control ────────────────────────────────────────────────────
#   `{{ define "…" -}}` — the trailing `-` trims whitespace AFTER the
#   define, so Slack does not render a leading blank line before the title.
#   Without it, every Slack message starts with 1–2 empty lines.
#
# ── Fallbacks ─────────────────────────────────────────────────────────────
#   `.Annotations.runbook_url` and `.Annotations.dashboard_url` are guarded
#   with `{{ if }}` — an alert without those annotations renders no link
#   rather than a broken `<a href="">`.

{{ define "green_agent.slack.title" -}}
[{{ .Status | toUpper }}{{ if eq .Status "firing" }} ({{ .Alerts.Firing | len }}){{ end }}] Green Agent Alert
{{- end }}

{{ define "green_agent.slack.text" -}}
{{ if gt (len .Alerts.Firing) 0 -}}
{{ range .Alerts.Firing -}}
*Alert:* `{{ .Labels.alertname }}` — {{ .Annotations.summary }}
*Severity:* {{ .Labels.severity }}
{{- if .Labels.component }}
*Component:* {{ .Labels.component }}
{{- end }}
{{- if .Labels.environment }}
*Environment:* {{ .Labels.environment }}
{{- end }}
*Started:* {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}

*Description:*
{{ .Annotations.description }}

{{- if .Annotations.symbolic_rule_id }}
*Symbolic Rule:* `{{ .Annotations.symbolic_rule_id }}`
{{- end }}

*Labels:*
{{- range .Labels.SortedPairs }}
  • {{ .Name }}: {{ .Value }}
{{- end }}

{{- if .Annotations.runbook_url }}
*Runbook:* {{ .Annotations.runbook_url }}
{{- end }}
{{- if .Annotations.dashboard_url }}
*Dashboard:* {{ .Annotations.dashboard_url }}
{{- end }}
*Source:* {{ .GeneratorURL }}
---
{{ end -}}
{{- else -}}
✅ All Green Agent alerts resolved

{{ range .Alerts.Resolved -}}
*Resolved:* `{{ .Labels.alertname }}` — {{ .Annotations.summary }}
*Resolved at:* {{ .EndsAt.Format "2006-01-02 15:04:05 MST" }}
---
{{ end -}}
{{- end -}}
{{- end }}

{{ define "green_agent.slack.color" -}}
{{- if eq .Status "firing" -}}
  {{- if eq .CommonLabels.severity "critical" -}}danger
  {{- else if or (eq .CommonLabels.severity "high") (eq .CommonLabels.severity "warning") -}}warning
  {{- else -}}good
  {{- end -}}
{{- else -}}good
{{- end -}}
{{- end }}
