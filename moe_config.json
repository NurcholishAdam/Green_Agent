{
    "enable_quantum": true,
    "max_carbon_budget_kg": 0.1,
    "max_helium_budget": 0.05,
    "max_latency_ms": 1000,
    "reflection_enabled": true,
    "monitoring_enabled": true,
    "pipeline_default": "standard",

    "expert_configuration": {
        "energy_expert": {
            "enabled": true,
            "quantization_levels": ["fp32", "fp16", "int8", "int4"],
            "default_quantization": "int8"
        },
        "data_expert": {
            "enabled": true,
            "compression_algorithms": ["none", "gzip", "lz4", "zstd"],
            "default_compression": "lz4"
        },
        "iot_expert": {
            "enabled": true,
            "edge_optimization": true
        },
        "helium_expert": {
            "enabled": true,
            "scarcity_threshold": 0.3
        },
        "quantum_expert": {
            "enabled": true,
            "backend_type": "simulator",
            "max_qubits": 20
        }
    },

    "gating_network": {
        "top_k": 2,
        "capacity_factor": 1.25,
        "noise_std": 0.1,
        "load_balance_weight": 0.01
    },

    "monitoring": {
        "prometheus_enabled": true,
        "grafana_dashboard_enabled": true,
        "metrics_retention_days": 30
    },

    "planetary_boundaries": {
        "carbon_emissions_limit_ppm": 350,
        "helium_scarcity_limit": 0.8,
        "energy_capacity_limit": 0.9
    },

    "enhancements": {
        "enabled": true,
        "limit_graph": {
            "enabled": true,
            "graph_metrics": {
                "centrality": 0.7,
                "connectivity": 0.6,
                "density": 0.5
            },
            "update_interval_seconds": 60,
            "influence_weight": 0.3
        },
        "modp": {
            "enabled": true,
            "objective_weights": [0.4, 0.3, 0.2, 0.1],
            "normalize_weights": true,
            "score_threshold_low": 0.4,
            "score_threshold_high": 0.7
        },
        "rlhf": {
            "enabled": true,
            "human_feedback_score": 0.6,
            "collect_feedback": true,
            "feedback_source": "dashboard"
        },
        "distillation": {
            "enabled": true,
            "use_moe_gating": true,
            "distillation_lr": 0.01,
            "gating_lr": 0.005,
            "replay_size": 2000,
            "train_every": 10,
            "epsilon": 0.1,
            "teachers": ["rule_based", "historical_ml", "q_learning", "rlhf"]
        },
        "bio_inspired": {
            "enabled": true,
            "use_evolutionary": true,
            "population_size": 20,
            "mutation_rate": 0.1,
            "crossover_rate": 0.7,
            "elitism": 2
        },
        "moe_expert": {
            "enabled": true,
            "n_experts": 4,
            "gating_lr": 0.005
        },
        "flexgen": {
            "enabled": true,
            "model_name": "facebook/opt-6.7b",
            "batch_size": 16,
            "memory_limit_mb": 4096,
            "precision_options": ["fp32", "fp16", "int8"],
            "default_precision": "fp16",
            "delegation_policy": "adaptive"
        }
    }
}
